# Server-only address of the Go API. FIDE reads saved snapshots from this service.
RATINGS_API_URL=http://127.0.0.1:8081

# The events Google Sheet, each tab published to the web as CSV. See docs/events-sheet.md.
# In development, the templates in docs/sheet-templates are served at these addresses:
EVENTS_SHEET_URL=http://127.0.0.1:5174/preview/sheet/events.csv
PRIZES_SHEET_URL=http://127.0.0.1:5174/preview/sheet/lichess-prizes.csv
