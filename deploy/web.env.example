# /etc/swahilichess/web.env, read by swahilichess-web.service.
# Create it once on the server: owner root, group the deploy user, mode 640.
ORIGIN=https://chess.tz
# The Go API on the same server. Use the port swahilichess-api.service listens on.
RATINGS_API_URL=http://127.0.0.1:API_PORT
# Published CSV links for the events sheet's two tabs; see docs/events-sheet.md.
EVENTS_SHEET_URL=
PRIZES_SHEET_URL=
